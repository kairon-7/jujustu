local function func18(arg1)
	if not arg1 or not arg1.Parent or not CurrentCamera then
		return false
	end

	local Character = LocalPlayer.Character

	if not Character then
		return false
	end

	local HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart")

	if not HumanoidRootPart then
		return false
	end

	local ok, result = pcall(function()
		return arg1.Position
	end)

	if not ok then
		return false
	end

	if v2.Aimbot_Smoothness < 0.99 then
		local currentCamera = CurrentCamera
		currentCamera.CFrame = currentCamera.CFrame:Lerp(
			CFrame.lookAt(currentCamera.CFrame.Position, result, Vector3.new(0, 1, 0)),
			v2.Aimbot_Smoothness
		)
	else
		local currentCamera1 = CurrentCamera
		currentCamera1.CFrame = CFrame.lookAt(
			currentCamera1.CFrame.Position,
			result,
			Vector3.new(0, 1, 0)
		)
	end

	local Position = HumanoidRootPart.Position
	HumanoidRootPart.CFrame = CFrame.lookAt(
		Position,
		Vector3.new(result.X, Position.Y, result.Z),
		Vector3.new(0, 1, 0)
	)
