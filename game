local function func11(player)
	if not player or player == LocalPlayer then
		return true
	end

	local ok, result = pcall(function()
		return LocalPlayer.Team
	end)
	local ok1, result1 = pcall(function()
		return player.Team
	end)

	if ok and ok1 and result and result1 and result ~= result1 then
		return false
	end

	if ok and ok1 and result and result1 and result == result1 then
		return true
	end

	local ok2, result2 = pcall(function()
		return LocalPlayer.TeamColor
	end)
	local ok3, result3 = pcall(function()
		return player.TeamColor
	end)

	if ok2 and ok3 and result2 and result3 and result2.Name ~= "Medium stone grey" then
		if result3.Name ~= "Medium stone grey" then
			return result2.Name == result3.Name
		end
	end

	return false
end

